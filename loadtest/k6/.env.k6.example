# Configuração da suíte de carga k6 — COPIE para .env.k6 e preencha.
# O .env.k6 é ignorado pelo git (contém segredo). Carregue com:
#   set -a; source loadtest/k6/.env.k6; set +a
# ou use os targets do Makefile (make k6-run), que fazem isso.

# --- Alvo -------------------------------------------------------------------
# URL da API V2. Default embutido no código já aponta para a Lambda develop;
# troque aqui para bater em outro ambiente.
K6_BASE_URL=https://ttwkfudhvvhuhp5yvsoydxggum0ictpg.lambda-url.sa-east-1.on.aws/v2

# --- Credenciais (o dono do teste entrega isto ao executor) -----------------
# Segredo HS256 de IDENTIDADE de develop. Necessário para forjar os JWTs dos VUs.
# NUNCA commitar. Peça ao responsável pela infra de develop.
JWT_IDENTITY_SECRET=

# Arquivo com as identidades reais (ids de usuários existentes em develop).
# Gere com scripts/k6-export-users.sql. Default: ./data/users.json
K6_USERS_FILE=./loadtest/k6/data/users.json
# Alternativa sem arquivo: lista de ids separada por vírgula.
# K6_USER_IDS=101,102,103

# TTL dos tokens forjados (segundos). Deve cobrir a duração do teste. Default 3h.
K6_TOKEN_TTL_SECONDS=10800

# --- Execução ---------------------------------------------------------------
# Perfil: smoke | soak | spike | full
PROFILE=smoke
# Timeout por request (espelha o front). Default 10s.
K6_REQUEST_TIMEOUT=10s
# Diretório de saída dos relatórios.
K6_OUT_DIR=./loadtest/k6/out

# --- Overrides opcionais de dimensionamento ---------------------------------
# K6_PARTICIPANTS=5000
# K6_HOLD=20m
# K6_RAMP=5m
# K6_DISPLAYS=10
# K6_MANAGERS=20
# K6_SPIKE_VUS=1500
# K6_MUT_RATE=30

# --- Observabilidade (opcional, só rotula o relatório) ----------------------
# Nome da função Lambda de develop, para montar o log group nas queries do relatório.
# K6_LAMBDA_FUNCTION_NAME=dnj-game-api-develop
