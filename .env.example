# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="DNJ Game API"
API_PREFIX="/v1"

# SERVER_RUNNER: "default" runs a local HTTP server; "lambda" runs as an AWS
# Lambda behind API Gateway (HTTP API / payload v2).
SERVER_RUNNER="default"
# Porta exclusiva da API. O frontend continua livre para usar 3000.
SERVER_PORT=8081

# SERVER_ENVIRONMENT: localhost | development | production | test
SERVER_ENVIRONMENT="localhost"
GIN_MODE="debug"

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_IDENTITY_SECRET="change_me_identity_secret"
# OAuth 2.0 client ID aceito no audience do ID token Google.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Chave independente usada para HMAC-SHA256 do CPF na V2.
DOCUMENT_HMAC_SECRET="change_me_document_hmac_secret"

# ─── Webhook de inscrição ────────────────────────────────────────────────────
# Shared secret the external subscription platform must send in the
# X-Webhook-Secret header when calling POST /subscriptions/webhook.
SUBSCRIPTION_WEBHOOK_SECRET="change_me_webhook_secret"

# ─── CORS & cookies ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Base URL of the frontend, used to build links inside transactional emails.
FRONTEND_URL="http://localhost:3000"
# Optional: shared parent domain when SPA and API share one (e.g. .example.com).
# COOKIE_DOMAIN=".example.com"

# ─── Email provider (Brevo-style transactional API) ─────────────────────────
EMAIL_SENDER_EMAIL="no-reply@example.com"
EMAIL_API_BASE_URL="https://api.brevo.com/v3/smtp/email"
EMAIL_API_KEY="your_email_api_key_here"

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_HOST=localhost
# Evita conflito com outros PostgreSQL locais que normalmente ocupam 5432.
DB_PORT=55432
DB_USER=dnjgame
DB_PASSWORD=dnjgame
DB_NAME=dnjgame

# ─── S3 local (MinIO; infraestrutura funcional entra na iteração de mídia) ──
S3_ENDPOINT="http://localhost:59000"
S3_PORT=59000
S3_CONSOLE_PORT=59001
S3_REGION="us-east-1"
S3_BUCKET="dnj-media-local"
S3_ACCESS_KEY="dnjgame"
S3_SECRET_KEY="change_me_local_s3_secret"
S3_USE_PATH_STYLE=true
