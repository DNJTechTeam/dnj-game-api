{
  "swagger": "2.0",
  "info": {
    "description": "API REST para gerenciamento de eventos e pontuações da gamificação DNJ.",
    "title": "DNJ Game API",
    "contact": {},
    "version": "1.0"
  },
  "basePath": "/v1",
  "paths": {
    "/auth/onboarding": {
      "post": {
        "description": "Localiza a inscrição pelo documento (CPF). Se o registro já tem email, envia o código e retorna status CODE_SENT com o email ofuscado. Se não tem email, retorna status EMAIL_REQUIRED sem enviar nada — a mesma rota deve ser chamada de novo com o campo email preenchido para completar o cadastro e enviar o código.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "auth"
        ],
        "summary": "Confirma inscrição e envia código de verificação",
        "parameters": [
          {
            "description": "Documento do inscrito (e opcionalmente o email, quando ainda não cadastrado)",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_messages.OnboardingRequestDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_messages.OnboardingResponseDTO"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_errors.Error"
            }
          }
        }
      }
    },
    "/auth/verification-code": {
      "post": {
        "description": "Confirma o código de verificação, cria o usuário na primeira verificação (idempotente nas seguintes) e retorna o identityToken.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "auth"
        ],
        "summary": "Verifica o código e retorna o token de identidade",
        "parameters": [
          {
            "description": "Email e código de verificação",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_messages.VerificationCodeRequestDTO"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_messages.VerificationCodeResponseDTO"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_errors.Error"
            }
          }
        }
      }
    },
    "/groups": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Lista grupos ou busca case-insensitive por nome, limitada a 20 resultados por página.",
        "produces": [
          "application/json"
        ],
        "tags": [
          "groups"
        ],
        "summary": "Busca grupos por nome",
        "parameters": [
          {
            "type": "string",
            "description": "Termo de busca (vazio ou mínimo 3 caracteres)",
            "name": "search",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "Página 1-indexed",
            "name": "page",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_messages.GroupSummaryDTO"
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/internal_presentation_api_handlers.APIError"
            }
          }
        }
      }
    },
    "/healthcheck": {
      "get": {
        "produces": [
          "application/json"
        ],
        "tags": [
          "healthcheck"
        ],
        "summary": "Healthcheck",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/subscriptions/webhook": {
      "post": {
        "description": "Grava o payload bruto e cria/atualiza um código de verificação pendente para o inscrito. Payload elástico (formato definido pela plataforma externa).",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "subscriptions"
        ],
        "summary": "Recebe o webhook de inscrição no evento",
        "parameters": [
          {
            "type": "string",
            "description": "Secret compartilhado com a plataforma externa",
            "name": "X-Webhook-Secret",
            "in": "header",
            "required": true
          },
          {
            "description": "Payload do webhook (formato elástico)",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Payload recebido"
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/github_com_dnjtechteam_dnj-game-api_internal_app_errors.Error"
            }
          },
          "401": {
            "description": "Secret inválido"
          }
        }
      }
    },
