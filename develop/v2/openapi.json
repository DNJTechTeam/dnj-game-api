{
  "components": {
    "headers": {
      "HasNextPage": {
        "description": "Indica existência da próxima página",
        "schema": {
          "type": "boolean"
        }
      },
      "Limit": {
        "description": "Quantidade máxima por página",
        "schema": {
          "type": "integer"
        }
      },
      "Page": {
        "description": "Página atual",
        "schema": {
          "type": "string"
        }
      },
      "RequestID": {
        "description": "Identificador seguro de correlação da requisição",
        "schema": {
          "type": "string"
        }
      },
      "SessionCookies": {
        "description": "identity_token e refresh_token são HttpOnly; csrf_token é legível pelo cliente. Em ambiente publicado todos são Secure e SameSite=None.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "ActivityID": {
        "in": "path",
        "name": "activityId",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "CSRFHeader": {
        "in": "header",
        "name": "X-CSRF-Token",
        "required": true,
        "schema": {
          "minLength": 32,
          "type": "string"
        }
      },
      "GroupID": {
        "in": "path",
        "name": "groupId",
        "required": true,
        "schema": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "description": "UUID estável reutilizado somente no retry da mesma intenção pelo mesmo ator.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "InviteID": {
        "in": "path",
        "name": "inviteId",
        "required": true,
        "schema": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        }
      },
      "Page": {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "requestBodies": {
      "UpdateCurrentGroup": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateCurrentGroupRequest"
            }
          }
        },
        "required": true
      }
    },
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Requisição inválida",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Estado atual impede a operação",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "DependencyUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Dependência obrigatória indisponível",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Proteção CSRF ou autorização rejeitou a requisição",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "IdentitySession": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/IdentitySessionResponse"
            }
          }
        },
        "description": "Sessão criada ou renovada",
        "headers": {
          "Set-Cookie": {
            "$ref": "#/components/headers/SessionCookies"
          },
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "InternalError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Erro interno sem detalhes sensíveis",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Recurso relacionado não encontrado",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Credencial ausente, inválida, expirada ou reutilizada",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestID"
          }
        }
      }
    },
    "schemas": {
      "ActivityState": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "paused"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "type": "object"
      },
      "CompleteOnboardingRequest": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "example": "52998224725",
            "type": "string"
          },
          "groupId": {
            "example": "12",
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "mobilePhone": {
            "example": "5541999990000",
            "type": "string"
          }
        },
        "required": [
          "document",
          "mobilePhone",
          "groupId"
        ],
        "type": "object"
      },
      "ConsumeGroupInviteRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Código opaco recebido fora da API de listagem.",
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "CurrentGroup": {
        "properties": {
          "group": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GroupSummary"
              }
            ],
            "nullable": true
          },
          "membership": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GroupMembership"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "group",
          "membership"
        ],
        "type": "object"
      },
      "CurrentProfile": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "documentMasked": {
            "description": "CPF integral e hashes nunca são retornados.",
            "readOnly": true,
            "type": "string"
          },
          "email": {
            "format": "email",
            "readOnly": true,
            "type": "string"
          },
          "group": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GroupSummary"
              }
            ],
            "nullable": true
          },
          "id": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "mobilePhone": {
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          },
          "onboardingComplete": {
            "readOnly": true,
            "type": "boolean"
          },
          "points": {
            "minimum": 0,
            "readOnly": true,
            "type": "integer"
          },
          "rankPosition": {
            "format": "int64",
            "minimum": 1,
            "readOnly": true,
            "type": "integer"
          },
          "role": {
            "enum": [
              "ADMIN",
              "EVENT_MANAGER",
              "DEFAULT"
            ],
            "readOnly": true,
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "mobilePhone",
          "documentMasked",
          "role",
          "group",
          "points",
          "rankPosition",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "CurrentSessionResponse": {
        "properties": {
          "onboardingRequired": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/IdentityUser"
          }
        },
        "required": [
          "onboardingRequired",
          "user"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "example": "UNAUTHENTICATED",
            "type": "string"
          },
          "details": {
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "type": "object"
      },
      "GoogleAuthRequest": {
        "additionalProperties": false,
        "properties": {
          "idToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "idToken"
        ],
        "type": "object"
      },
      "GroupInvite": {
        "properties": {
          "consumedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "consumedByUserId": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "createdByUserId": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "replacesInviteId": {
            "nullable": true,
            "type": "string"
          },
          "revokedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "EXPIRED",
              "REVOKED",
              "CONSUMED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "groupId",
          "status",
          "expiresAt",
          "revokedAt",
          "consumedAt",
          "consumedByUserId",
          "createdByUserId",
          "replacesInviteId",
          "createdAt"
        ],
        "type": "object"
      },
      "GroupInviteWithCode": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GroupInvite"
          },
          {
            "properties": {
              "code": {
                "description": "Exibido somente na criação ou renovação.",
                "minLength": 20,
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        ]
      },
      "GroupMember": {
        "properties": {
          "id": {
            "type": "string"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "EVENT_MANAGER",
              "DEFAULT"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "joinedAt"
        ],
        "type": "object"
      },
      "GroupMembership": {
        "properties": {
          "groupId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "groupId",
          "joinedAt"
        ],
        "type": "object"
      },
      "GroupSummary": {
        "properties": {
          "groupName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "groupName"
        ],
        "type": "object"
      },
      "HealthcheckResponse": {
        "properties": {
          "service": {
            "enum": [
              "dnj-game-api"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "type": "object"
      },
      "IdentitySessionResponse": {
        "properties": {
          "accessToken": {
            "description": "JWT HS256 válido por 900 segundos",
            "type": "string"
          },
          "csrfToken": {
            "description": "Mesmo valor do cookie csrf_token",
            "type": "string"
          },
          "expiresIn": {
            "enum": [
              900
            ],
            "format": "int64",
            "type": "integer"
          },
          "onboardingRequired": {
            "type": "boolean"
          },
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/IdentityUser"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "csrfToken",
          "onboardingRequired",
          "user"
        ],
        "type": "object"
      },
      "IdentityUser": {
        "properties": {
          "documentMasked": {
            "description": "CPF integral nunca é retornado pela V2",
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "group": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GroupSummary"
              }
            ],
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "mobilePhone": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "onboardingComplete": {
            "type": "boolean"
          },
          "role": {
            "enum": [
              "ADMIN",
              "EVENT_MANAGER",
              "DEFAULT"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "mobilePhone",
          "documentMasked",
          "role",
          "group",
          "onboardingComplete"
        ],
        "type": "object"
      },
      "LogoutResponse": {
        "properties": {
          "status": {
            "enum": [
              "logged_out"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "PaginatedGroupInvites": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/GroupInvite"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "required": [
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "PaginatedGroupMembers": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/GroupMember"
            },
            "type": "array"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "required": [
          "data",
          "pagination"
        ],
        "type": "object"
      },
      "Pagination": {
        "properties": {
          "currentPage": {
            "type": "string"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "limit": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "currentPage",
          "hasNextPage",
          "limit"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "enum": [
              "ready"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Space": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "mapReference": {
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "mapReference"
        ],
        "type": "object"
      },
      "UpdateCurrentGroupRequest": {
        "additionalProperties": false,
        "properties": {
          "groupId": {
            "nullable": true,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "groupId"
        ],
        "type": "object"
      },
      "UpdateCurrentProfileRequest": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "mobilePhone": {
            "maxLength": 13,
            "minLength": 11,
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "csrfCookie": {
        "in": "cookie",
        "name": "csrf_token",
        "type": "apiKey"
      },
      "identityCookie": {
        "in": "cookie",
        "name": "identity_token",
        "type": "apiKey"
      },
      "refreshCookie": {
        "in": "cookie",
        "name": "refresh_token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Contrato canônico da V2; somente operações implementadas e testadas são publicadas.",
    "title": "DNJ Game API V2",
    "version": "2.3.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/admin/groups/{groupId}/invites": {
      "get": {
        "operationId": "listGroupInvites",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedGroupInvites"
                }
              }
            },
            "description": "Página de convites sem códigos"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "identityCookie": []
          }
        ],
        "summary": "Lista convites do grupo para administradores",
        "tags": [
          "Group invites"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupID"
        }
      ],
      "post": {
        "description": "O código aparece somente nesta resposta e nunca é persistido em claro.",
        "operationId": "createGroupInvite",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupInviteWithCode"
                }
              }
            },
            "description": "Convite criado com código"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "identityCookie": []
          }
        ],
        "summary": "Cria convite de sete dias para administradores",
        "tags": [
          "Group invites"
        ]
      }
    },
    "/admin/groups/{groupId}/invites/{inviteId}": {
      "delete": {
        "operationId": "revokeGroupInvite",
        "responses": {
          "204": {
            "description": "Convite revogado ou já revogado"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "identityCookie": []
          }
        ],
        "summary": "Revoga de forma idempotente um convite não consumido",
        "tags": [
          "Group invites"
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupID"
        },
        {
          "$ref": "#/components/parameters/InviteID"
        }
      ]
    },
    "/admin/groups/{groupId}/invites/{inviteId}/renew": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupID"
        },
        {
          "$ref": "#/components/parameters/InviteID"
        }
      ],
      "post": {
        "operationId": "renewGroupInvite",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupInviteWithCode"
                }
              }
            },
            "description": "Novo convite e código"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "identityCookie": []
          }
        ],
        "summary": "Revoga o convite anterior e cria outro atomicamente",
        "tags": [
          "Group invites"
        ]
      }
    },
